node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.save
.env.backup

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
debug.log
*.log

# Misc
.DS_Store
*.pem
cache
*.cache

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Archives
*.zip
*.tar
*.tar.gz
*.rar

# Debug scripts
debug-*.js
verify-*.js
cleanup-*.js

# WordPress imports
*.xml
# …except the /sitemap.xml route folder (an app route named like a file).
!/apps/web/app/sitemap.xml/
!/apps/web/app/sitemap.xml/**

# Binaries
nest
next
turbo
tsc
web@*
api@*

# PM2
.pm2

# IDE
.vscode/
.idea/
*.sublime-*

# Uploaded media (served by the API from disk)
/uploads/
/private-uploads/


# Live server secrets and full database exports — never committed.
# (deploy/seed/pakhotels-seed.json.gz IS committed: site content only, no accounts.)
/deploy/live-env/
/deploy/*.json.gz
# IndexNow key file, written by deploy/deploy.sh from apps/web/.env
/apps/web/public/[0-9a-f]*.txt

# WordPress export (re-made with: python scripts/wp-dump.py data/wp-export)
data/wp-export/
